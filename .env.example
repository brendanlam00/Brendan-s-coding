# Copy to .env and fill in. Never commit .env.

# Long-lived access token from your Meta app (Facebook Login for Business)
# Needs: instagram_basic, instagram_content_publish, instagram_manage_insights,
#        pages_show_list, pages_read_engagement
IG_ACCESS_TOKEN=

# Your Instagram professional account's numeric ID (NOT your @handle)
IG_USER_ID=

# Graph API version
IG_API_VERSION=v23.0

# Folders and database (relative to where you run reelbot)
REELBOT_INBOX=inbox
REELBOT_EDITED=edited
REELBOT_PROCESSED=processed
REELBOT_DB=reelbot.db

# Trial reels: MANUAL = you decide (reelbot promotes the winner),
#              SS_PERFORMANCE = Instagram auto-shares to followers if it performs well
REELBOT_GRADUATION=MANUAL

# How long a trial runs before it is judged (hours)
REELBOT_TRIAL_HOURS=48

# A trial needs at least this many views to be promoted at all
REELBOT_MIN_VIEWS=0

# Caption used when a video has no matching .txt file
REELBOT_DEFAULT_CAPTION=

# Variations made from each video, each posted as its own Trial Reel.
# Choose from: letterbox, mirror, hook, main
REELBOT_VARIANTS=letterbox,mirror,hook

# Let Claude write the hook lines + pick the cold-open moment (needs: pip install 'reelbot[ai]'
# and auto-captions installed). Set to off to skip.
REELBOT_AI_HOOKS=on
ANTHROPIC_API_KEY=
